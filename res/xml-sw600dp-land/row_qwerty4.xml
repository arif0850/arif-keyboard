<?xml version="1.0" encoding="utf-8"?>
<merge
  xmlns:latin="http://schemas.android.com/apk/res-auto">
    <switch>
        <case latin:isSplitLayout="true">
            <Row latin:backgroundType="functional" latin:keyWidth="7.0000052%p">
                <include latin:keyboardLayout="@xml/key_to_symbol" />
                <include latin:backgroundType="normal" latin:keyboardLayout="@xml/key_space_3kw" />
                <Key latin:keyActionFlags="noKeyPreview|enableLongPress" latin:keyStyle="enterKeyStyle" latin:keyWidth="10.000002%p" />
            </Row>
        </case>
        <default>
            <Row latin:backgroundType="functional" latin:keyWidth="9.000004%p">
                <include latin:keyWidth="10.000002%p" latin:keyboardLayout="@xml/key_to_symbol" />
                <include latin:backgroundType="normal" latin:keyXPos="10.000002%p" latin:keyboardLayout="@xml/key_space_7kw" />
                <Key latin:keyActionFlags="noKeyPreview|enableLongPress" latin:keyStyle="enterKeyStyle" latin:keyWidth="10.000002%p" />
            </Row>
        </default>
    </switch>
</merge>
