<?xml version="1.0" encoding="utf-8"?>
<merge
  xmlns:latin="http://schemas.android.com/apk/res-auto">
    <include latin:keyboardLayout="@xml/key_styles_common" />
    <switch>
        <case latin:fifthAvenue="true">
            <switch>
                <case latin:fifthAvenueWithLargeRow="true">
                    <include latin:keyboardLayout="@xml/row_number_en_bn" />
                </case>
                <default>
                    <include latin:keyboardLayout="@xml/row_number_en_bn_for_number_additional_row" />
                </default>
            </switch>
        </case>
    </switch>
    <Row>
        <switch>
            <case latin:isSplitLayout="true">
                <include latin:keyWidth="7.0000052%p" latin:keyboardLayout="@xml/rowkeys_bangla_provat1_left6" />
                <Spacer latin:keyWidth="15.999996%p" />
                <include latin:keyWidth="7.0000052%p" latin:keyboardLayout="@xml/rowkeys_bangla_provat1_right6" />
            </case>
            <default>
                <include latin:keyWidth="8.333004%p" latin:keyboardLayout="@xml/rowkeys_bangla_provat1" />
            </default>
        </switch>
    </Row>
    <Row>
        <switch>
            <case latin:isSplitLayout="true">
                <include latin:keyWidth="7.0000052%p" latin:keyXPos="4.999995%p" latin:keyboardLayout="@xml/rowkeys_bangla_provat2_left5" />
                <Spacer latin:keyWidth="20.000004%p" />
                <Key latin:keyLabelFlags="fontDefault" latin:keySpec="?" latin:keyWidth="7.0000052%p" />
                <include latin:keyWidth="7.0000052%p" latin:keyboardLayout="@xml/rowkeys_bangla_provat2_right4" />
            </case>
            <default>
                <include latin:keyWidth="10.000002%p" latin:keyXPos="4.999995%p" latin:keyboardLayout="@xml/rowkeys_bangla_provat2" />
            </default>
        </switch>
    </Row>
    <Row>
        <switch>
            <case latin:isSplitLayout="true">
                <Key latin:keyStyle="shiftKeyStyle" latin:keyWidth="9.000004%p" />
                <include latin:keyWidth="7.0000052%p" latin:keyboardLayout="@xml/rowkeys_bangla_provat3_left5" />
                <Spacer latin:keyWidth="12.0%p" />
                <Key latin:keyLabelFlags="fontDefault" latin:keySpec="!" latin:keyWidth="7.0000052%p" />
                <include latin:keyWidth="7.0000052%p" latin:keyboardLayout="@xml/rowkeys_bangla_provat3_right4" />
                <Key latin:keyStyle="deleteKeyStyle" latin:keyWidth="fillRight" />
            </case>
            <default>
                <Key latin:keyStyle="shiftKeyStyle" latin:keyWidth="10.000002%p" />
                <include latin:keyWidth="9.000004%p" latin:keyboardLayout="@xml/rowkeys_bangla_provat3" />
                <Key latin:keyStyle="deleteKeyStyle" latin:keyWidth="fillRight" />
            </default>
        </switch>
    </Row>
    <include latin:keyboardLayout="@xml/row_qwerty4" />
</merge>
