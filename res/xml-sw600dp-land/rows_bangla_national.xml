<?xml version="1.0" encoding="utf-8"?>
<merge
  xmlns:latin="http://schemas.android.com/apk/res-auto">
    <include latin:keyboardLayout="@xml/key_styles_common" />
    <Row>
        <switch>
            <case latin:isSplitLayout="true">
                <include latin:keyWidth="7.0000052%p" latin:keyboardLayout="@xml/rowkeys_bangla_national1_left5" />
                <Spacer latin:keyWidth="29.999996%p" />
                <include latin:keyWidth="7.0000052%p" latin:keyboardLayout="@xml/rowkeys_bangla_national1_right5" />
            </case>
            <default>
                <include latin:keyWidth="10.000002%p" latin:keyboardLayout="@xml/rowkeys_bangla_national1" />
            </default>
        </switch>
    </Row>
    <Row>
        <switch>
            <case latin:isSplitLayout="true">
                <include latin:keyWidth="7.0000052%p" latin:keyXPos="3.9999962%p" latin:keyboardLayout="@xml/rowkeys_bangla_national2_left5" />
                <Spacer latin:keyWidth="21.000004%p" />
                <Key latin:keyLabelFlags="fontRidmikAscii|followKeyLabelRatio" latin:keyLabelSize="@fraction/ridmik_font_size_ratio" latin:keySpec="ñ|্" latin:keyWidth="7.0000052%p" />
                <include latin:keyWidth="7.0000052%p" latin:keyboardLayout="@xml/rowkeys_bangla_national2_right4" />
            </case>
            <default>
                <include latin:keyWidth="10.000002%p" latin:keyXPos="4.4999957%p" latin:keyboardLayout="@xml/rowkeys_bangla_national2" />
            </default>
        </switch>
    </Row>
    <Row>
        <switch>
            <case latin:isSplitLayout="true">
                <Key latin:keyStyle="shiftKeyStyle" latin:keyWidth="10.000002%p" />
                <include latin:keyWidth="7.0000052%p" latin:keyboardLayout="@xml/rowkeys_bangla_national3_left4" />
                <Spacer latin:keyWidth="24.0%p" />
                <Key latin:keyLabelFlags="fontDefault" latin:keySpec="!" latin:keyWidth="7.0000052%p" />
                <include latin:keyWidth="7.0000052%p" latin:keyboardLayout="@xml/rowkeys_bangla_national3_right3" />
                <Key latin:keyStyle="deleteKeyStyle" latin:keyWidth="fillRight" />
            </case>
            <default>
                <Key latin:keyStyle="shiftKeyStyle" latin:keyWidth="10.000002%p" />
                <include latin:keyWidth="9.000004%p" latin:keyboardLayout="@xml/rowkeys_bangla_national3" />
                <include latin:keyWidth="9.000004%p" latin:keyboardLayout="@xml/keys_exclamation_question" />
                <Key latin:keyStyle="deleteKeyStyle" latin:keyWidth="fillRight" />
            </default>
        </switch>
    </Row>
    <include latin:keyboardLayout="@xml/row_qwerty4" />
</merge>
