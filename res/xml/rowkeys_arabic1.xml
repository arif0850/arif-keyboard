<?xml version="1.0" encoding="utf-8"?>
<merge
  xmlns:latin="http://schemas.android.com/apk/res-auto">
    <switch>
        <case latin:fifthAvenue="true">
            <Key latin:keySpec="ض" />
            <Key latin:keySpec="ص" />
            <Key latin:keySpec="ث" />
            <Key latin:keySpec="ق" />
            <Key latin:keySpec="ف" />
            <Key latin:keySpec="غ" />
            <Key latin:keySpec="ع" />
            <Key latin:additionalMoreKeys="ہ" latin:keySpec="ه" />
            <Key latin:keySpec="خ" />
            <Key latin:keySpec="ح" />
            <Key latin:keyHintLabel="چ" latin:keySpec="ج" latin:moreKeys="چ,ﷻ" />
        </case>
        <default>
            <Key latin:additionalMoreKeys="١,1" latin:keyHintLabel="١" latin:keySpec="ض" />
            <Key latin:additionalMoreKeys="٢,2" latin:keyHintLabel="٢" latin:keySpec="ص" />
            <Key latin:additionalMoreKeys="٣,3" latin:keyHintLabel="٣" latin:keySpec="ث" />
            <Key latin:additionalMoreKeys="٤,4" latin:keyHintLabel="٤" latin:keySpec="ق" latin:moreKeys="ڨ" />
            <Key latin:additionalMoreKeys="٥,5" latin:keyHintLabel="٥" latin:keySpec="ف" latin:moreKeys="ڤ,ڢ,ڥ,ڡ" />
            <Key latin:additionalMoreKeys="٦,6" latin:keyHintLabel="٦" latin:keySpec="غ" />
            <Key latin:additionalMoreKeys="٧,7" latin:keyHintLabel="٧" latin:keySpec="ع" />
            <Key latin:additionalMoreKeys="٨,8" latin:keyHintLabel="٨" latin:keySpec="ه" latin:moreKeys="ﻫ|ه‍" />
            <Key latin:additionalMoreKeys="٩,9" latin:keyHintLabel="٩" latin:keySpec="خ" />
            <Key latin:additionalMoreKeys="٠,0" latin:keyHintLabel="٠" latin:keySpec="ح" />
            <Key latin:keyHintLabel="چ" latin:keySpec="ج" latin:moreKeys="چ,ﷻ" />
        </default>
    </switch>
</merge>
