<?xml version="1.0" encoding="utf-8"?>
<merge
  xmlns:latin="http://schemas.android.com/apk/res-auto">
    <switch>
        <case latin:keyboardLayoutSetElement="banglaFixedAlphabetShifted">
            <Key latin:keyLabelFlags="fontArifAscii|followKeyLabelRatio" latin:keyLabelSize="@fraction/arif_font_size_ratio" latin:keySpec="Ò|ভ" />
            <Key latin:keyLabelFlags="fontArifAscii|followKeyLabelRatio" latin:keyLabelSize="@fraction/arif_font_size_ratio" latin:keySpec="¼|খ" />
            <Key latin:keyHintLabel="Þ" latin:keyLabelFlags="fontArifAscii|followKeyLabelRatio" latin:keyLabelSize="@fraction/arif_font_size_ratio" latin:keySpec="Ë|থ" latin:moreKeys="Þ|ৎ" />
            <Key latin:keyHintLabel="à" latin:keyLabelFlags="fontArifAscii|followKeyLabelRatio" latin:keyLabelSize="@fraction/arif_font_size_ratio" latin:keySpec="Í|ধ" latin:moreKeys="à|ঃ" />
        </case>
        <default>
            <Key latin:keyHintLabel="Ò" latin:keyLabelFlags="fontArifAscii|followKeyLabelRatio" latin:keyLabelSize="@fraction/arif_font_size_ratio" latin:keySpec="Ñ|ব" latin:moreKeys="Ò|ভ" />
            <Key latin:keyHintLabel="¼" latin:keyLabelFlags="fontArifAscii|followKeyLabelRatio" latin:keyLabelSize="@fraction/arif_font_size_ratio" latin:keySpec="»|ক" latin:moreKeys="¼|খ" />
            <Key latin:keyHintLabel="Ë" latin:keyLabelFlags="fontArifAscii|followKeyLabelRatio" latin:keyLabelSize="@fraction/arif_font_size_ratio" latin:keySpec="Ê|ত" latin:moreKeys="Ë|থ,Þ|ৎ" />
            <Key latin:keyHintLabel="Í" latin:keyLabelFlags="fontArifAscii|followKeyLabelRatio" latin:keyLabelSize="@fraction/arif_font_size_ratio" latin:keySpec="Ì|দ" latin:moreKeys="Í|ধ,à|ঃ" />
        </default>
    </switch>
</merge>
