<?xml version="1.0" encoding="utf-8"?>
<merge
  xmlns:latin="http://schemas.android.com/apk/res-auto">
    <include latin:keyboardLayout="@xml/key_styles_common" />
    <include latin:keyboardLayout="@xml/key_styles_currency" />
    <switch>
        <case latin:fifthAvenue="true">
            <switch>
                <case latin:fifthAvenueWithLargeRow="true">
                    <include latin:keyboardLayout="@xml/row_number_en_bn" />
                </case>
                <default>
                    <include latin:keyboardLayout="@xml/row_number_en_bn_for_number_additional_row" />
                </default>
            </switch>
            <Row latin:keyWidth="10.500002%p">
                <Key latin:keyStyle="tabKeyStyle" latin:keyXPos="2.7500033%p" />
                <Key latin:keySpec="~" />
                <Key latin:keySpec="\\" />
                <Key latin:keySpec="&lt;" />
                <Key latin:keySpec=">" />
                <Key latin:keySpec="_" />
                <Key latin:keySpec="=" />
                <Key latin:keySpec="[" />
                <Key latin:keySpec="]" />
            </Row>
        </case>
        <default>
            <include latin:keyboardLayout="@xml/row_number_en_bn" />
        </default>
    </switch>
    <Row latin:keyWidth="10.000002%p">
        <include latin:keyboardLayout="@xml/rowkeys_symbols2" />
    </Row>
    <Row latin:keyWidth="10.000002%p">
        <Key latin:keyStyle="toMoreSymbolKeyStyle" latin:keyWidth="14.999998%p" latin:visualInsetsRight="0.99999905%p" />
        <include latin:keyboardLayout="@xml/rowkeys_symbols3" />
        <Key latin:keyStyle="deleteKeyStyle" latin:keyWidth="fillRight" latin:visualInsetsLeft="0.99999905%p" />
    </Row>
    <Row latin:backgroundType="functional" latin:keyWidth="10.000002%p">
        <switch>
            <case latin:currentLanguageType="banglaFixed">
                <Key latin:keyLabelFlags="fontArifAscii|followKeyLabelRatio|preserveCase|followFunctionalTextColor" latin:keyLabelSize="@fraction/arif_font_size_ratio_alpha_switch" latin:keySpec="±»¼|!code/key_switch_alpha_symbol" latin:keyStyle="toAlphaKeyStyle" latin:keyWidth="14.999998%p" />
            </case>
            <case latin:currentLanguageType="arabic">
                <Key latin:keySpec="أبت|!code/key_switch_alpha_symbol" latin:keyStyle="toAlphaKeyStyle" latin:keyWidth="14.999998%p" />
            </case>
            <case latin:currentLanguageType="sylheti">
                <Key latin:keySpec="ꠀꠇꠈ|!code/key_switch_alpha_symbol" latin:keyStyle="toAlphaKeyStyle" latin:keyWidth="14.999998%p" />
            </case>
            <case latin:currentLanguageType="chakma">
                <Key latin:keySpec="𑄃𑄇𑄈|!code/key_switch_alpha_symbol" latin:keyStyle="toAlphaKeyStyle" latin:keyWidth="14.999998%p" />
            </case>
            <default>
                <Key latin:keyStyle="toAlphaKeyStyle" latin:keyWidth="14.999998%p" />
            </default>
        </switch>
        <include latin:keyboardLayout="@xml/row_symbols4" />
        <Key latin:keyStyle="enterKeyStyle" latin:keyWidth="fillRight" />
    </Row>
</merge>
