<?xml version="1.0" encoding="utf-8"?>
<merge
  xmlns:latin="http://schemas.android.com/apk/res-auto">
    <switch>
        <case latin:keyboardLayoutSetElement="chakmaShifted">
            <Key latin:keySpec="𑄞" />
            <Key latin:keySpec="𑄈" />
            <Key latin:keySpec="𑄗" />
            <Key latin:keySpec="𑄙" />
            <Key latin:keySpec="𑄀" />
        </case>
        <default>
            <Key latin:keySpec="𑄝" latin:moreKeys="𑅇" />
            <Key latin:keySpec="𑄇" />
            <Key latin:keySpec="𑄖" />
            <Key latin:keySpec="𑄘" />
            <Key latin:keySpec="𑄴" />
        </default>
    </switch>
</merge>
