<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <switch>
        <case latin:mode="email|url">
            <Key latin:keyStyle="comKeyStyle" latin:keyWidth="fillRight" />
        </case>
        <default>
            <Key latin:keySpec="Alt|!code/key_emoji" latin:keyStyle="emojiKeyStyle" latin:keyWidth="fillRight" />
        </default>
    </switch>
</merge>
