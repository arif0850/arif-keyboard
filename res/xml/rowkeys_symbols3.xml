<?xml version="1.0" encoding="utf-8"?>
<merge
  xmlns:latin="http://schemas.android.com/apk/res-auto">
    <Key latin:keySpec="!" latin:moreKeys="!text/morekeys_exclamation" />
    <Key latin:keySpec="&quot;" latin:moreKeys="!text/morekeys_double_quote" />
    <Key latin:keySpec="'" latin:moreKeys="!text/morekeys_single_quote" />
    <Key latin:keyHintLabel="à" latin:keyLabelFlags="fontHintRidmikAscii" latin:keySpec=":" latin:moreKeys="à|ঃ" />
    <Key latin:keySpec="!text/keyspec_symbols_semicolon" latin:moreKeys="!text/morekeys_symbols_semicolon" />
    <Key latin:keySpec="/" />
    <switch>
        <case latin:keyboardLayoutSetElement="symbolsArabic">
            <Key latin:keySpec="؟" latin:moreKeys="!text/morekeys_question,!text/keyspec_symbols_question,𑅃" />
        </case>
        <case latin:keyboardLayoutSetElement="symbolsChakma">
            <Key latin:keySpec="𑅃" latin:moreKeys="!text/morekeys_question,!text/keyspec_symbols_question,؟" />
        </case>
        <default>
            <Key latin:keySpec="!text/keyspec_symbols_question" latin:moreKeys="!text/morekeys_question,؟,𑅃" />
        </default>
    </switch>
</merge>
