<?xml version="1.0" encoding="utf-8"?>
<merge
  xmlns:latin="http://schemas.android.com/apk/res-auto">
    <include latin:keyboardLayout="@xml/key_styles_common" />
    <Key latin:keyStyle="tabKeyStyle" />
    <Key latin:keyStyle="moreCurrency1KeyStyle" />
    <Key latin:keySpec="$" />
    <Key latin:keySpec="℅" />
    <Key latin:keyHintLabel="→" latin:keySpec="^" latin:moreKeys="↑,↓,←,→" />
    <Key latin:keyHintLabel="•" latin:keySpec="°" latin:moreKeys="′,•,″" />
    <Key latin:keySpec="_" />
    <Key latin:keyHintLabel="≠" latin:keySpec="=" latin:moreKeys="≠,≈,∞" />
    <include latin:keyboardLayout="@xml/keys_square_brackets" />
</merge>
