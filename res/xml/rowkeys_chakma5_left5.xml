<?xml version="1.0" encoding="utf-8"?>
<merge
  xmlns:latin="http://schemas.android.com/apk/res-auto">
    <switch>
        <case latin:keyboardLayoutSetElement="chakmaShifted">
            <Key latin:keySpec="1" />
            <Key latin:keySpec="2" />
            <Key latin:keySpec="3" />
            <Key latin:keySpec="4" />
            <Key latin:keySpec="5" />
        </case>
        <default>
            <Key latin:keySpec="𑄷" />
            <Key latin:keySpec="𑄸" />
            <Key latin:keySpec="𑄹" />
            <Key latin:keySpec="𑄺" />
            <Key latin:keySpec="𑄻" />
        </default>
    </switch>
</merge>
