<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <switch>
        <case latin:languageSwitchKeyEnabled="true">
            <Key latin:keyStyle="languageSwitchKeyStyle" />
            <include latin:keyboardLayout="@xml/key_comma" />
            <Key latin:keyStyle="spaceKeyStyle" latin:keyWidth="29.999996%p" />
            <include latin:keyboardLayout="@xml/key_period" />
            <Key latin:keyStyle="emojiKeyStyle" />
        </case>
        <default>
            <Key latin:keyStyle="emojiKeyStyle" />
            <include latin:keyboardLayout="@xml/key_comma" />
            <Key latin:keyStyle="spaceKeyStyle" latin:keyWidth="39.999996%p" />
            <include latin:keyboardLayout="@xml/key_period" />
        </default>
    </switch>
</merge>
