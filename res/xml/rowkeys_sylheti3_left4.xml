<?xml version="1.0" encoding="utf-8"?>
<merge
  xmlns:latin="http://schemas.android.com/apk/res-auto">
    <switch>
        <case latin:keyboardLayoutSetElement="sylhetiShifted">
            <Key latin:keySpec="꠆" />
            <Key latin:keySpec="ꠓ" />
            <Key latin:keySpec="ꠍ" />
            <Key latin:keySpec="ꠜ" />
        </case>
        <default>
            <Key latin:keySpec="꠆" />
            <Key latin:keyHintLabel="ꠓ" latin:keySpec="ꠒ" latin:moreKeys="ꠓ" />
            <Key latin:keyHintLabel="ꠍ" latin:keySpec="ꠌ" latin:moreKeys="ꠍ" />
            <Key latin:keySpec="ꠜ" />
        </default>
    </switch>
</merge>
