<?xml version="1.0" encoding="utf-8"?>
<merge
  xmlns:latin="http://schemas.android.com/apk/res-auto">
    <include latin:keyboardLayout="@xml/key_styles_common" />
    <include latin:keyboardLayout="@xml/key_styles_number" />
    <Row>
        <Key latin:keyStyle="num1KeyStyle" />
        <Key latin:keyStyle="num2KeyStyle" />
        <Key latin:keyStyle="num3KeyStyle" />
        <Key latin:backgroundType="functional" latin:keyLabelFlags="hasPopupHint|followFunctionalTextColor" latin:keySpec="-" latin:keyStyle="numKeyStyle" latin:keyWidth="fillRight" latin:moreKeys="+" />
    </Row>
    <Row>
        <Key latin:keyStyle="num4KeyStyle" />
        <Key latin:keyStyle="num5KeyStyle" />
        <Key latin:keyStyle="num6KeyStyle" />
        <Key latin:backgroundType="functional" latin:keyLabelFlags="followFunctionalTextColor" latin:keySpec="." latin:keyStyle="numKeyStyle" latin:keyWidth="fillRight" />
    </Row>
    <Row>
        <Key latin:keyStyle="num7KeyStyle" />
        <Key latin:keyStyle="num8KeyStyle" />
        <Key latin:keyStyle="num9KeyStyle" />
        <Key latin:keyStyle="deleteKeyStyle" latin:keyWidth="fillRight" />
    </Row>
    <Row>
        <switch>
            <case latin:mode="date">
                <Key latin:keyLabelFlags="followFunctionalTextColor" latin:keySpec="/" latin:keyStyle="numKeyStyle" />
            </case>
            <case latin:mode="time">
                <Key latin:keyLabelFlags="followFunctionalTextColor" latin:keySpec=":" latin:keyStyle="numKeyStyle" />
            </case>
            <case latin:mode="datetime">
                <Key latin:keyLabelFlags="followFunctionalTextColor" latin:keySpec="/ :|/" latin:keyStyle="numKeyStyle" latin:moreKeys="!noPanelAutoMoreKey!,:" />
            </case>
            <case latin:mode="number">
                <Key latin:keyLabelFlags="followFunctionalTextColor" latin:keySpec="," latin:keyStyle="numKeyStyle" />
            </case>
            <default>
                <Key latin:keyStyle="numPhoneToSymbolKeyStyle" />
            </default>
        </switch>
        <switch>
            <case latin:mode="phone">
                <Key latin:keySpec="0 +|0" latin:keyStyle="num0KeyStyle" latin:moreKeys="!noPanelAutoMoreKey!,+" />
            </case>
            <default>
                <Key latin:keySpec="0" latin:keyStyle="num0KeyStyle" />
            </default>
        </switch>
        <Key latin:keyStyle="numSpaceKeyStyle" />
        <Key latin:keyStyle="enterKeyStyle" latin:keyWidth="fillRight" />
    </Row>
</merge>
