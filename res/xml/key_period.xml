<?xml version="1.0" encoding="utf-8"?>
<merge
  xmlns:latin="http://schemas.android.com/apk/res-auto">
    <switch>
        <case latin:keyboardLayoutSetElement="avroAlphabet|avroManualShifted|avroAutomaticShifted|avroShiftLocked|avroShiftLockShifted|banglaFixedAlphabet|banglaFixedAlphabetShifted">
            <Key latin:backgroundType="functional" latin:keyHintLabel="!text/keyhintlabel_period" latin:keyLabelFlags="fontRidmikAscii|followKeyLabelRatio|hasPopupHint|hasShiftedLetterHint|preserveCase|followFunctionalTextColor" latin:keyLabelSize="@fraction/ridmik_font_size_ratio" latin:keySpec="å|।" latin:moreKeys="!string/morekeys_period_bn" />
        </case>
        <case latin:keyboardLayoutSetElement="sylheti|sylhetiShifted">
            <Key latin:backgroundType="functional" latin:keyHintLabel="!text/keyhintlabel_period" latin:keyLabelFlags="fontRidmikAscii|followKeyLabelRatio|hasPopupHint|hasShiftedLetterHint|preserveCase|followFunctionalTextColor" latin:keyLabelSize="@fraction/ridmik_font_size_ratio" latin:keySpec="å|।" latin:moreKeys="!string/morekeys_period_sylheti" />
        </case>
        <case latin:keyboardLayoutSetElement="chakma|chakmaShifted">
            <Key latin:backgroundType="functional" latin:keyHintLabel="!text/keyhintlabel_period" latin:keyLabelFlags="followKeyLetterRatio|hasPopupHint|hasShiftedLetterHint|preserveCase|followFunctionalTextColor" latin:keyLabelSize="@fraction/ridmik_font_size_ratio" latin:keySpec="𑅁" latin:moreKeys="!string/morekeys_period_chakma" />
        </case>
        <case latin:keyboardLayoutSetElement="arabic">
            <Key latin:backgroundType="functional" latin:keyHintLabel="!text/keyhintlabel_period" latin:keyLabelFlags="hasPopupHint|hasShiftedLetterHint|followFunctionalTextColor" latin:keySpec="!text/keyspec_period" latin:moreKeys="!string/morekeys_arabic_diacritics" />
        </case>
        <default>
            <Key latin:backgroundType="functional" latin:keyHintLabel="!text/keyhintlabel_period" latin:keyLabelFlags="hasPopupHint|hasShiftedLetterHint|followFunctionalTextColor" latin:keySpec="!text/keyspec_period" latin:moreKeys="!text/morekeys_period" />
        </default>
    </switch>
</merge>
