<?xml version="1.0" encoding="utf-8"?>
<merge
  xmlns:latin="http://schemas.android.com/apk/res-auto">
    <include latin:keyboardLayout="@xml/key_styles_common" />
    <switch>
        <case latin:fifthAvenue="true">
            <switch>
                <case latin:fifthAvenueWithLargeRow="true">
                    <Row latin:keyWidth="9.090996%p">
                        <include latin:keyboardLayout="@xml/rowkeys_arabic5_left5" />
                        <include latin:keyboardLayout="@xml/rowkeys_arabic5_right5" />
                    </Row>
                </case>
                <default>
                    <Row latin:keyWidth="9.090996%p" latin:rowHeight="14.999998%p">
                        <include latin:keyboardLayout="@xml/rowkeys_arabic5_left5" />
                        <include latin:keyboardLayout="@xml/rowkeys_arabic5_right5" />
                    </Row>
                </default>
            </switch>
        </case>
    </switch>
    <Row latin:keyLabelFlags="fontNormal" latin:keyWidth="9.090996%p">
        <include latin:keyboardLayout="@xml/rowkeys_arabic1" />
    </Row>
    <Row latin:keyLabelFlags="fontNormal" latin:keyWidth="9.090996%p">
        <include latin:keyboardLayout="@xml/rowkeys_arabic2" />
    </Row>
    <Row latin:keyLabelFlags="fontNormal" latin:keyWidth="9.090996%p">
        <include latin:keyboardLayout="@xml/rowkeys_arabic3" />
        <Key latin:keyStyle="deleteKeyStyle" latin:keyWidth="fillRight" />
    </Row>
    <include latin:keyboardLayout="@xml/row_qwerty4" />
</merge>
