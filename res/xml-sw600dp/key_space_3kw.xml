<?xml version="1.0" encoding="utf-8"?>
<merge
  xmlns:latin="http://schemas.android.com/apk/res-auto">
    <switch>
        <case latin:languageSwitchKeyEnabled="true" latin:showEmojiKey="true">
            <Key latin:keyStyle="languageSwitchKeyStyle" />
            <include latin:keyboardLayout="@xml/key_comma" />
            <Key latin:keyStyle="spaceKeyStyle" latin:keyWidth="21.000004%p" />
            <Spacer latin:keyWidth="17.999994%p" />
            <Key latin:keyStyle="spaceKeyStyle" latin:keyWidth="15.999996%p" />
            <include latin:keyboardLayout="@xml/key_period" />
            <Key latin:keyStyle="emojiKeyStyle" />
        </case>
        <case latin:languageSwitchKeyEnabled="true" latin:showEmojiKey="false">
            <include latin:keyboardLayout="@xml/key_comma" />
            <Key latin:keyStyle="languageSwitchKeyStyle" />
            <Key latin:keyStyle="spaceKeyStyle" latin:keyWidth="21.000004%p" />
            <Spacer latin:keyWidth="25.0%p" />
            <Key latin:keyStyle="spaceKeyStyle" latin:keyWidth="15.999996%p" />
            <include latin:keyboardLayout="@xml/key_period" />
        </case>
        <case latin:languageSwitchKeyEnabled="false" latin:showEmojiKey="true">
            <Key latin:keyStyle="emojiKeyStyle" />
            <include latin:keyboardLayout="@xml/key_comma" />
            <Key latin:keyStyle="spaceKeyStyle" latin:keyWidth="21.000004%p" />
            <Spacer latin:keyWidth="25.0%p" />
            <Key latin:keyStyle="spaceKeyStyle" latin:keyWidth="15.999996%p" />
            <include latin:keyboardLayout="@xml/key_period" />
        </case>
        <default>
            <include latin:keyboardLayout="@xml/key_comma" />
            <Key latin:keyStyle="spaceKeyStyle" latin:keyWidth="24.0%p" />
            <include latin:keyboardLayout="@xml/key_period" />
        </default>
    </switch>
</merge>
