<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_active="true" android:state_pressed="true" android:drawable="@null" />
    <item android:state_active="true" android:drawable="@null" />
    <item android:state_checkable="true" android:state_checked="true" android:state_pressed="true" android:drawable="@null" />
    <item android:state_checkable="true" android:state_pressed="true" android:layout_width="match_parent" android:layout_height="wrap_content" android:drawable="@null" />
    <item android:state_checkable="true" android:state_checked="true">
        <layer-list>
            <item android:left="15.0dp" android:top="35.0dp" android:right="15.0dp" android:bottom="3.0dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/pinkDark" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_checkable="true">
        <layer-list>
            <item android:left="15.0dp" android:top="35.0dp" android:right="15.0dp" android:bottom="3.0dp">
                <shape android:shape="rectangle">
                    <solid android:color="#d23d78" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true" android:state_empty="true" android:drawable="@color/key_background_pressed_lxx_dark" />
    <item android:state_empty="true" android:drawable="@android:color/transparent" />
    <item android:state_pressed="true" android:drawable="@color/pinkDark" />
    <item android:drawable="@color/pink" />
</selector>
